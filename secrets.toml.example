# Copy this file to .streamlit/secrets.toml (for running locally) or paste its
# contents into your app's Settings > Secrets on Streamlit Community Cloud.
# NEVER commit the real secrets.toml to GitHub.

# Optional: ask for a password before showing the dashboard.
app_password = "choose-a-password"

[sheets]
spreadsheet_url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

# Copy each value from the JSON key file you downloaded from Google Cloud.
# Keep the private_key on one line, with the \n sequences exactly as they appear in the JSON.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "abc123..."
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "card-show-ledger@your-project-id.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/card-show-ledger%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
